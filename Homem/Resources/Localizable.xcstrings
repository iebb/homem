    "Allow microphone access in iOS Settings to record a voice message.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在 iOS 设置中允许访问麦克风，以录制语音消息。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite el acceso al micrófono en Ajustes de iOS para grabar mensajes de voz."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iOSの設定でマイクへのアクセスを許可すると、音声メッセージを録音できます。"
