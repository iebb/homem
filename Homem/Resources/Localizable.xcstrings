    "Advanced server controls. Forms follow the API version bundled with Homem. Your server enforces permissions and feature availability.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "高级设置使用 Homem 内置的 API 版本，权限与可用功能由服务器决定。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los formularios usan la versión de la API incluida en Homem. Los permisos y las funciones dependen del servidor."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Homemに同梱されたAPIに対応する詳細設定です。権限と利用できる機能はサーバー側で決まります。"
          }
        }
      }
    },
    "After signing in, tap Continue. You can switch to email at any time.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "登录后点按“继续”。你也可以随时改用邮箱登录。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tras iniciar sesión, toca Continuar. Puedes usar el correo en cualquier momento."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ログイン後に「続ける」をタップしてください。いつでもメールに切り替えられます。"
          }
        }
      }
    },
